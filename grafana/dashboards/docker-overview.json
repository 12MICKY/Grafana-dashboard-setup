      "targets": [
        {
          "expr": "topk(10, max by (namespace, pod, container) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",container!=\"\",pod!=\"\",node=~\"$node\"}[5m]) * 100))",
          "legendFormat": "{{namespace}}/{{pod}}/{{container}}"
