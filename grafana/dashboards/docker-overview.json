      "type": "timeseries",
      "title": "Top Pod Disk IO",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "topk(10, max by (namespace, pod, container) (rate(container_fs_reads_bytes_total{job=\"cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",container!=\"\",pod!=\"\",node=~\"$node\"}[5m])))",
          "legendFormat": "read {{namespace}}/{{pod}}/{{container}}"
        },
        {
          "expr": "topk(10, max by (namespace, pod, container) (rate(container_fs_writes_bytes_total{job=\"cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",container!=\"\",pod!=\"\",node=~\"$node\"}[5m])))",
          "legendFormat": "write {{namespace}}/{{pod}}/{{container}}"
        }
