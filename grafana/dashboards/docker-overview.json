          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "K3s Node Network",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "sum by(node,device)(rate(node_network_receive_bytes_total{job=\"node-exporter\",node=~\"$node\",device!~\"lo|flannel.*|cni.*|veth.*|tunl.*\"}[5m]))",
          "legendFormat": "rx {{node}} {{device}}"
        },
        {
          "expr": "sum by(node,device)(rate(node_network_transmit_bytes_total{job=\"node-exporter\",node=~\"$node\",device!~\"lo|flannel.*|cni.*|veth.*|tunl.*\"}[5m]))",
          "legendFormat": "tx {{node}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "No data"
